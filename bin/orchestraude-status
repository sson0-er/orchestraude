#!/usr/bin/env bash
# Prints the next step of a feature, derived only from its files, so the
# orchestrator can start, resume in a new session, or find its place again
# after context compaction without relying on memory. The first unmet
# condition wins. Gate 1 is the Status line the requirements skill writes;
# gates 2 to 4 and completion are lines the orchestrator appends to gates.md.
# A second line names the design model when the feature recorded one.
set -eu

usage() { echo "Usage: orchestraude-status <feature-slug> [--cwd DIR]" >&2; exit 2; }

[ $# -ge 1 ] || usage
slug="$1"; shift
cwd="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) [ $# -ge 2 ] || usage; cwd="$2"; shift 2 ;;
    *) usage ;;
  esac
done
case "$slug" in
  *[!a-z0-9-]*|"") echo "invalid slug: $slug (use [a-z0-9-])" >&2; exit 2 ;;
esac

d="$cwd/docs/orchestraude/$slug"
recorded() { grep -q "^- $1 " "$d/gates.md" 2>/dev/null; }

# Task definitions are tasks/<id>.md. "<id>.findings.md" and
# "<id>.findings.history.md" sit next to them; their stem has a dot, an id
# never does.
tasks=0 pending=0
for f in "$d"/tasks/*.md; do
  [ -e "$f" ] || continue
  id="$(basename "$f" .md)"
  case "$id" in *.*) continue ;; esac
  tasks=$((tasks + 1))
  status="$(awk 'NR==1 && $0!="---"{exit} NR>1 && $0=="---"{exit} $1=="status:"{print $2; exit}' "$f")"
  [ "$status" = "done" ] || pending=$((pending + 1))
done

if ! grep -q '^Status: approved' "$d/01-requirements.md" 2>/dev/null; then
  echo "next: phase-1 (requirements, gate 1)"
elif [ ! -s "$d/02-research.md" ]; then
  echo "next: phase-2 step 1 (research)"
elif [ ! -s "$d/03-design/README.md" ]; then
  echo "next: phase-2 step 2 (design)"
elif ! recorded "gate 2"; then
  echo "next: phase-2 step 3 (open questions, design review, gate 2)"
elif [ ! -s "$d/04-plan.md" ] || [ "$tasks" -eq 0 ]; then
  echo "next: phase-3 step 1 (plan)"
elif ! recorded "gate 3"; then
  echo "next: phase-3 step 2 (gate 3)"
elif [ "$pending" -gt 0 ]; then
  echo "next: phase-4 (pending tasks: $pending)"
elif ! recorded "gate 4"; then
  echo "next: phase-4.9 (low-findings triage, gate 4)"
elif ! recorded "done"; then
  echo "next: phase-5 (documentation)"
else
  echo "next: done"
fi

# A feature started with the Fable variant keeps its design roles on that
# model for its whole life. Repeating the choice on every call is what lets
# a resumed or compacted orchestrator still apply it.
if [ "$(head -n 1 "$d/design-model" 2>/dev/null)" = "fable" ]; then
  echo "design-model: fable"
fi
