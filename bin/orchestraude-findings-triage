#!/usr/bin/env bash
# Deterministically pre-merges the leftover low-severity findings of every
# task in a feature so the triage agent judges only the merged items, not
# every raw restatement. Dedup key is role + normalized title.
set -eu

usage() {
  echo "Usage: orchestraude-findings-triage --tasks-dir DIR --out FILE" >&2
  exit 2
}

tasks_dir="" out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tasks-dir) [ $# -ge 2 ] || usage; tasks_dir="$2"; shift 2 ;;
    --out) [ $# -ge 2 ] || usage; out="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$tasks_dir" ] && [ -n "$out" ] || usage
[ -d "$tasks_dir" ] || { echo "no such directory: $tasks_dir" >&2; exit 2; }

# Tag each low finding with its task id and reviewer role, taken from
# "<task>.round-<N>.findings.<role>.json" (files written before rounds were
# part of the name have no ".round-<N>"). Every round is read: a reviewer
# does not repeat earlier lows in a fix round, so the last round alone would
# lose them. No matching files is not an error: it just yields zero
# findings. Missing title/location/detail (e.g. a null) are coerced to "" so
# a malformed finding cannot crash the pipeline.
tagged="$(mktemp "${TMPDIR:-/tmp}/orchestraude-triage.XXXXXX")"
trap 'rm -f "$tagged"' EXIT
: > "$tagged"
for f in "$tasks_dir"/*.findings.*.json; do
  [ -e "$f" ] || continue
  jq -e '.findings | type == "array" and all(.[]; type == "object" and (.severity | IN("high","medium","low")))' "$f" >/dev/null 2>&1 || { echo "invalid findings json (findings must be an array of objects with severity high|medium|low): $f" >&2; exit 2; }
  base="$(basename "$f" .json)"
  task="${base%%.findings.*}"
  task="${task%.round-[0-9]*}"
  role="${base##*.findings.}"
  jq -c --arg task "$task" --arg role "$role" \
    '.findings[] | select(.severity == "low") | {task: $task, role: $role, title: (.title // ""), location: (.location // ""), detail: (.detail // "")}' \
    "$f" >> "$tagged"
done

# Normalized title: lowercase, whitespace collapsed to one space,
# leading/trailing space and a trailing "." or ":" removed.
norm_def='def norm: ascii_downcase | gsub("\\s+"; " ") | sub("^ +"; "") | sub(" +$"; "") | sub("[.:]+$"; "") | sub(" +$"; "");'

# A finding is one task + role + normalized title: the same low reported in
# two rounds of a task, or at two places in it, is counted once.
raw="$(jq -s "$norm_def"' [.[] | [.task, .role, (.title | norm)]] | unique | length' "$tagged")"

mkdir -p "$(dirname "$out")" || { echo "cannot create output directory for: $out" >&2; exit 2; }

if [ "$raw" -eq 0 ]; then
  {
    echo "# Low findings (merged)"
    echo
    echo "raw: 0, merged: 0, by role (merged): quality 0, security 0, spec 0, tests 0"
    echo
    echo "No low findings."
  } > "$out" || { echo "cannot write output file: $out" >&2; exit 2; }
  echo "raw: 0 merged: 0"
  exit 0
fi

# Group by role + normalized title and assign stable ids L001.. in that
# sorted order. group_by/sort are stable, so the first element of each group
# is the first occurrence. An empty normalized title (from a missing/null
# title) is still a valid key. The occurrence count is the number of tasks
# the finding appears in. Up to 5 unique locations are kept per group; the
# rest are only counted.
groups="$(mktemp "${TMPDIR:-/tmp}/orchestraude-triage-groups.XXXXXX")"
trap 'rm -f "$tagged" "$groups"' EXIT
jq -s "$norm_def"'
  map(. + {_norm: (.title | norm)})
  | group_by([.role, ._norm])
  | to_entries
  | map(
      .value as $g
      | $g[0] as $first
      | ((.key + 1) | tostring) as $n
      | ([$g[].location] | map(select(. != "")) | unique) as $locs
      | ([$g[].task] | unique) as $tasks
      | {
          id: ("L" + (if ($n | length) == 1 then "00" + $n elif ($n | length) == 2 then "0" + $n else $n end)),
          role: $first.role,
          bucket: (if ($first._norm | startswith("design ambiguity:")) then "B" else "toTriage" end),
          title: $first.title,
          count: ($tasks | length),
          tasks: $tasks,
          locations: ($locs[0:5]),
          locations_extra: (if ($locs | length) > 5 then ($locs | length) - 5 else 0 end),
          detail: (([$g[].detail] | map(select(. != "")))[0] // "")
        }
    )
' "$tagged" > "$groups" || { echo "internal error: grouping low findings failed" >&2; exit 2; }

merged="$(jq 'length' "$groups")" || { echo "internal error: reading merged count failed" >&2; exit 2; }

role_count() { jq --arg r "$1" '[.[] | select(.role == $r)] | length' "$groups"; }
rq="$(role_count quality)"; rs="$(role_count security)"; rsp="$(role_count spec)"; rt="$(role_count tests)"
by_role="quality $rq, security $rs, spec $rsp, tests $rt"

# Roles beyond the four known ones are never dropped: they are appended to
# the header, sorted, and still get their own "### <role>" section below.
extra_roles="$(jq -r '
  [.[] | .role] | unique
  | map(select(. as $r | (["quality","security","spec","tests"] | index($r)) == null))
  | sort | .[]
' "$groups")"
for r in $extra_roles; do
  by_role="$by_role, $r $(role_count "$r")"
done

item_line() {
  jq -r '
    (.title | gsub("\\s+"; " ")) as $title
    | (if .detail == "" then "(none)" else (.detail | gsub("\\s+"; " ")) end) as $detail
    | (if (.locations | length) == 0 then "(none)" else ([.locations[]] | join("; ")) end) as $locs0
    | ($locs0 + (if .locations_extra > 0 then " (+\(.locations_extra) more)" else "" end)) as $locs
    | "- \(.id) [\(.role)] \($title) (\(.count) occurrences; tasks: \([.tasks[]] | join(", "))) — location: \($locs) — detail: \($detail)"
  '
}

role_section() {
  role="$1"
  items="$(jq --arg r "$role" '[.[] | select(.bucket == "toTriage" and .role == $r)]' "$groups")"
  [ "$(printf '%s' "$items" | jq 'length')" -eq 0 ] && return
  echo "### $role"
  printf '%s' "$items" | jq -c '.[]' | while IFS= read -r line; do
    printf '%s\n' "$line" | item_line
  done
}

{
  echo "# Low findings (merged)"
  echo
  echo "raw: $raw, merged: $merged, by role (merged): $by_role"
  echo

  b_items="$(jq '[.[] | select(.bucket == "B")]' "$groups")"
  if [ "$(printf '%s' "$b_items" | jq 'length')" -gt 0 ]; then
    echo "## Pre-assigned B (design ambiguity)"
    echo
    printf '%s' "$b_items" | jq -c '.[]' | while IFS= read -r line; do
      printf '%s\n' "$line" | item_line
    done
    echo
  fi

  triage_count="$(jq '[.[] | select(.bucket == "toTriage")] | length' "$groups")"
  if [ "$triage_count" -gt 0 ]; then
    echo "## To triage"
    echo
    for role in quality security spec tests $extra_roles; do
      role_section "$role"
    done
  fi
} > "$out" || { echo "cannot write output file: $out" >&2; exit 2; }

echo "raw: $raw merged: $merged"
