#!/usr/bin/env bash
# Creates the docs/orchestraude layout in a target project, and a placeholder
# verify script when the project has none. Idempotent so the orchestrate
# skill can call it at the start of every feature safely.
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
usage() { echo "Usage: orchestraude-init <feature-slug> [--cwd DIR]" >&2; exit 2; }

[ $# -ge 1 ] || usage
slug="$1"; shift
cwd="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) [ $# -ge 2 ] || usage; cwd="$2"; shift 2 ;;
    *) usage ;;
  esac
done
# Slugs become directory names and file prefixes; keep them shell-safe.
case "$slug" in
  *[!a-z0-9-]*|"") echo "invalid slug: $slug (use [a-z0-9-])" >&2; exit 2 ;;
esac

base="$cwd/docs/orchestraude"
mkdir -p "$base/$slug/tasks" "$base/evidence" "$base/decisions"

if [ ! -e "$base/evidence/INDEX.md" ]; then
  cp "$ROOT/templates/evidence-index.md" "$base/evidence/INDEX.md"
fi
# The orchestrator and the triage agent only ever append to or read this
# file; creating it here keeps the template path out of their prompts.
if [ ! -e "$base/review-policy.md" ]; then
  cp "$ROOT/templates/review-policy.md" "$base/review-policy.md"
fi
if [ ! -e "$base/$slug/01-requirements.md" ]; then
  sed "s/<feature>/$slug/g" "$ROOT/templates/requirements.md" > "$base/$slug/01-requirements.md"
fi
# A project with no verify script, typically a new repository, could not
# start: there is nothing to write one from before the design has chosen the
# tools. The placeholder fails on purpose, so the verify gate stays closed
# until the first planned task replaces it with the real checks. A project
# that names its own command through ORCHESTRAUDE_VERIFY_CMD is left alone.
if [ -z "${ORCHESTRAUDE_VERIFY_CMD:-}" ] && [ ! -e "$cwd/scripts/verify.sh" ]; then
  mkdir -p "$cwd/scripts"
  cp "$ROOT/templates/verify.sh" "$cwd/scripts/verify.sh"
  chmod +x "$cwd/scripts/verify.sh"
  echo "created scripts/verify.sh: a placeholder that fails until the first planned task replaces it"
fi
echo "initialized $base/$slug"
