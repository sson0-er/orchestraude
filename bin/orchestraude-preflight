#!/usr/bin/env bash
# Checks what the whole flow depends on before any work is done. Without
# this, a missing git repository or a verify script that cannot run only
# surfaces after three approval gates and the first implementation. Prints one line per missing
# prerequisite and exits 1 if there is any.
set -u

usage() { echo "Usage: orchestraude-preflight [--cwd DIR]" >&2; exit 2; }

cwd="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --cwd) [ $# -ge 2 ] || usage; cwd="$2"; shift 2 ;;
    *) usage ;;
  esac
done
cd "$cwd" || exit 2

missing=0
miss() { echo "missing: $1"; missing=1; }

command -v jq >/dev/null 2>&1 || miss "jq (validates and merges reports and findings)"
[ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ] \
  || miss "a git repository (review rounds diff snapshots of the working tree)"
# No scripts/verify.sh at all is fine: orchestraude-init writes a failing
# placeholder that the first planned task replaces. A script that exists but
# cannot run, or a command the project named itself, is a mistake to fix.
cmd="${ORCHESTRAUDE_VERIFY_CMD:-scripts/verify.sh}"
if [ -e "$cmd" ] || [ -n "${ORCHESTRAUDE_VERIFY_CMD:-}" ]; then
  [ -x "$cmd" ] || miss "an executable verify script: $cmd"
fi

[ "$missing" -eq 0 ] && echo "preflight ok"
exit "$missing"
