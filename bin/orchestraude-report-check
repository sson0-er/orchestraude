#!/usr/bin/env bash
# Validates an implementer report against schemas/report.schema.json and
# prints its status line. The implementer writes the JSON itself, so this
# is the deterministic gate that keeps a malformed report from reaching
# the orchestrator, and it saves the orchestrator from reading the file.
set -u

usage() { echo "Usage: orchestraude-report-check FILE" >&2; exit 2; }

[ $# -eq 1 ] || usage
case "$1" in -*) usage ;; esac
file="$1"
[ -f "$file" ] || { echo "report not found: $file" >&2; exit 2; }

jq -e '
  def strings: type == "array" and all(.[]; type == "string");
  type == "object"
  and (.status | IN("done", "blocked"))
  and (.summary | type == "string")
  and (.changed_files | strings)
  and (.tests_added | strings)
  and (.open_questions | strings)
  and (.dod_check | type == "array" and all(.[];
        type == "object"
        and (.item | type == "string")
        and (.met | type == "boolean")
        and (.note | type == "string")))
' "$file" >/dev/null 2>&1 || {
  echo "invalid report json (see schemas/report.schema.json): $file" >&2
  exit 2
}

echo "status: $(jq -r .status "$file") open_questions: $(jq '.open_questions | length' "$file")"
